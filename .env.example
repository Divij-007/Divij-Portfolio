# Supabase Configuration
# Replace with your Supabase Project settings (Dashboard -> Project Settings -> API)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Admin Authorization
# The email address allowed to access and edit the /admin dashboard
VITE_ADMIN_EMAIL=your-email@example.com
